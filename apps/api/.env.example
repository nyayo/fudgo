# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=fudgo-media
# R2_CUSTOM_DOMAIN=...
# R2_REGION=auto
# R2_ENDPOINT_URL=...
# MAX_UPLOAD_SIZE_MB=5
# ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
