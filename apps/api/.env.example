ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8002

DB_HOST=db
DB_PORT=5432
DB_USER=fudz
DB_PASSWORD=password
DB_NAME=fudgo
DB_SSLMODE=disable
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20
DB_ECHO=False

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Phase 1+ will need:
# JWT_SECRET=...
# GOOGLE_CLIENT_ID=...
# TWILIO_ACCOUNT_SID=... (later, if used)
# TEXTBEE_API_KEY=...
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase.json
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=fudgo-media
# R2_CUSTOM_DOMAIN=...
# R2_REGION=auto
# R2_ENDPOINT_URL=...
# MAX_UPLOAD_SIZE_MB=5
# ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
# MAX_IMAGE_DIMENSION_PX=4096
# DEFAULT_SEARCH_RADIUS_KM=5.0
# MAX_SEARCH_RADIUS_KM=50.0

# --- WebSocket ---
WS_MAX_CONNECTIONS_PER_USER=5
WS_PING_INTERVAL_S=30
WS_PONG_TIMEOUT_S=10

# Phase 6 -- notifications, payouts, admin
FIREBASE_CREDENTIALS_JSON=   # full service-account JSON as a string (never a file)
FIREBASE_PROJECT_ID=
PLUNK_API_KEY=
PLUNK_FROM_EMAIL=no-reply@fudgo.com
PLUNK_FROM_NAME=Fudgo
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_SENDER_ID=Fudgo
PLATFORM_FEE_PERCENT=0.15
COURIER_DELIVERY_FEE_PERCENT=0.10
PAYOUT_PROCESSING_HOUR_UTC=2
PAYOUT_MIN_ORDER_AGE_HOURS=24
PAYOUT_RETRY_BACKOFF_S=3600
AUTO_DISPATCH_TIMEOUT_S=60
