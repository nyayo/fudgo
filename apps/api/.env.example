ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8002

DB_HOST=db
DB_PORT=5432
DB_USER=fudgo
DB_PASSWORD=password
DB_NAME=fudgo
DB_SSLMODE=disable
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20
DB_ECHO=False

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Phase 1+ will need:
# JWT_SECRET=...
# GOOGLE_CLIENT_ID=...
