async def test_checkout_unavailable_item_raises(db_session: Any) -> None:
    from app.orders.exceptions import MenuItemUnavailable
    from app.orders.models import CartItem

    customer_user = await _user(db_session, user_type=UserType.customer)
    cp = await _customer(db_session, customer_user)
    owner = await _user(db_session, user_type=UserType.restaurant)
    r = await _restaurant(db_session, owner)
    item = await _menu_item(db_session, r, is_available=False)
    address = await _address(db_session, customer_user)
    cart = await order_service.get_or_create_cart(db_session, cp.id)
    # Bypass the add_item_to_cart availability check by inserting directly
    ci = CartItem(cart_id=cart.id, menu_item_id=item.id, quantity=1)
    db_session.add(ci)
    await db_session.flush()
    with pytest.raises(MenuItemUnavailable):
        await order_service.checkout_cart(db_session, cp.id, address.id, None)


async def test_checkout_min_order_amount_raises(db_session: Any) -> None:
    from sqlalchemy import update
    from app.orders.exceptions import MinOrderAmountNotMet

    customer_user = await _user(db_session, user_type=UserType.customer)
    cp = await _customer(db_session, customer_user)
    owner = await _user(db_session, user_type=UserType.restaurant)
    r = await _restaurant(db_session, owner)
    # Raise the min_order_amount
    await db_session.execute(
        update(RestaurantProfile)
        .where(RestaurantProfile.id == r.id)
        .values(min_order_amount=Decimal("9999.00"))
    )
    item = await _menu_item(db_session, r, price="100.00")
    address = await _address(db_session, customer_user)
    cart = await order_service.get_or_create_cart(db_session, cp.id)
    await order_service.add_item_to_cart(db_session, cart, item.id, 1, None)
    with pytest.raises(MinOrderAmountNotMet):
        await order_service.checkout_cart(db_session, cp.id, address.id, None)


async def test_checkout_address_out_of_range_raises(db_session: Any) -> None:
    from app.orders.exceptions import DeliveryAddressOutOfRange

    customer_user = await _user(db_session, user_type=UserType.customer)
    cp = await _customer(db_session, customer_user)
    owner = await _user(db_session, user_type=UserType.restaurant)
    r = await _restaurant(db_session, owner)
    item = await _menu_item(db_session, r, price="100.00")
    # restaurant at (36.8, -1.3), radius 10km; address 200km away
    address = await _address(db_session, customer_user, lng=39.0, lat=1.0)
    cart = await order_service.get_or_create_cart(db_session, cp.id)
    await order_service.add_item_to_cart(db_session, cart, item.id, 1, None)
    with pytest.raises(DeliveryAddressOutOfRange):
        await order_service.checkout_cart(db_session, cp.id, address.id, None)


# ---------------------------------------------------------------------------
# State machine + cancel tests (already worked; included for parity)
# ---------------------------------------------------------------------------


async def _force_order_to_state(
    session: Any, *, target: OrderStatus
) -> tuple[Order, User, User]:
    """Helper: build an order in PENDING_PAYMENT then jump it to ``target``
    via the existing transition logic (or raw SQL when transition doesn't allow it).
    """
    customer_user = await _user(session, user_type=UserType.customer)
    cp = await _customer(session, customer_user)
    owner = await _user(session, user_type=UserType.restaurant)
    r = await _restaurant(session, owner)
    item = await _menu_item(session, r, price="100.00")
    address = await _address(session, customer_user)
    cart = await order_service.get_or_create_cart(session, cp.id)
    await order_service.add_item_to_cart(session, cart, item.id, 1, None)
    order = await order_service.checkout_cart(session, cp.id, address.id, None)

    # Walk through the state machine until we reach ``target``.
    walk: list[OrderStatus] = []
    current = order.status
    while current != target:
        if current == OrderStatus.PENDING_PAYMENT:
            # In real flow, payment webhook does this; here we just force it.
            await session.execute(
                __import__("sqlalchemy").text(
                    "UPDATE orders SET status='placed' WHERE id = :id"
                ).bindparams(id=str(order.id))
            )
            current = OrderStatus.PLACED
            walk.append(current)
            continue
        if current == OrderStatus.PLACED:
            order.status = OrderStatus.CONFIRMED
            current = OrderStatus.CONFIRMED
            walk.append(current)
            continue
        if current == OrderStatus.CONFIRMED:
            order.status = OrderStatus.PREPARING
            current = OrderStatus.PREPARING
            walk.append(current)
            continue
        if current == OrderStatus.PREPARING:
            order.status = OrderStatus.READY
            current = OrderStatus.READY
            walk.append(current)
            continue
        if current == OrderStatus.READY:
            order.status = OrderStatus.PICKED_UP
            current = OrderStatus.PICKED_UP
            walk.append(current)
            continue
        if current == OrderStatus.PICKED_UP:
            order.status = OrderStatus.ON_THE_WAY
            current = OrderStatus.ON_THE_WAY
            walk.append(current)
            continue
        if current == OrderStatus.ON_THE_WAY:
            order.status = OrderStatus.DELIVERED
            current = OrderStatus.DELIVERED
            walk.append(current)
            continue
        break
    await session.flush()
    return order, customer_user, owner


async def test_restaurant_confirm_transition(db_session: Any) -> None:
    order, _cu, owner = await _force_order_to_state(db_session, target=OrderStatus.PLACED)
    order = await order_service.transition_order(
        db_session, order, OrderStatus.CONFIRMED,
        changed_by_user_id=owner.id, changed_by_role="restaurant"
    )
    assert order.status == OrderStatus.CONFIRMED


async def test_restaurant_full_flow(db_session: Any) -> None:
    order, _cu, owner = await _force_order_to_state(db_session, target=OrderStatus.PLACED)
    for to in [OrderStatus.CONFIRMED, OrderStatus.PREPARING, OrderStatus.READY]:
        order = await order_service.transition_order(
            db_session, order, to,
            changed_by_user_id=owner.id, changed_by_role="restaurant"
        )
    assert order.status == OrderStatus.READY


async def test_invalid_transition_raises(db_session: Any) -> None:
    from app.orders.exceptions import OrderInvalidTransition

    order, _cu, owner = await _force_order_to_state(db_session, target=OrderStatus.PLACED)
    with pytest.raises(OrderInvalidTransition):
        await order_service.transition_order(
            db_session, order, OrderStatus.READY,
            changed_by_user_id=owner.id, changed_by_role="restaurant"
        )


async def test_customer_cancel_before_preparing_succeeds(db_session: Any) -> None:
    order, customer_user, _owner = await _force_order_to_state(
        db_session, target=OrderStatus.CONFIRMED
    )
    order = await order_service.cancel_order(
        db_session, order,
        cancelled_by_user_id=customer_user.id, role="customer", reason="changed mind"
    )
    assert order.status == OrderStatus.CANCELLED
    assert order.cancellation_reason == "changed mind"


async def test_customer_cancel_after_preparing_raises(db_session: Any) -> None:
    from app.orders.exceptions import OrderNotCancellable

    order, customer_user, _owner = await _force_order_to_state(
        db_session, target=OrderStatus.PREPARING
    )
    with pytest.raises(OrderNotCancellable):
        await order_service.cancel_order(
            db_session, order,
            cancelled_by_user_id=customer_user.id, role="customer", reason="x"
        )


async def test_restaurant_cancel_after_picked_up_raises(db_session: Any) -> None:
    from app.orders.exceptions import OrderNotCancellable

    order, _cu, owner = await _force_order_to_state(
        db_session, target=OrderStatus.PICKED_UP
    )
    with pytest.raises(OrderNotCancellable):
        await order_service.cancel_order(
            db_session, order,
            cancelled_by_user_id=owner.id, role="restaurant", reason="x"
        )


async def test_courier_cancel_before_picked_up_succeeds(db_session: Any) -> None:
    order, _cu, _owner = await _force_order_to_state(
        db_session, target=OrderStatus.PICKED_UP
    )
    courier_user = await _user(db_session, user_type=UserType.courier)
    from app.users.models import CourierProfile
    db_session.add(CourierProfile(user_id=courier_user.id, vehicle_type="bike"))
    await db_session.flush()
    order = await order_service.cancel_order(
        db_session, order,
        cancelled_by_user_id=courier_user.id, role="courier", reason="vehicle broke"
    )
    assert order.status == OrderStatus.CANCELLED


async def test_pay_returns_existing_payment(db_session: Any) -> None:
    """Sanity: after checkout, the payment row exists in PENDING."""
    order, customer_user, _owner = await _force_order_to_state(
        db_session, target=OrderStatus.PLACED
    )
    from app.orders.models import Payment
    from app.orders.enums import PaymentStatus
    payment = (
        await db_session.execute(
            select(Payment).where(Payment.order_id == order.id)
        )
    ).scalar_one()
    assert payment.status == PaymentStatus.PENDING
